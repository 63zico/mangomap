EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Supabase backend for production auth, reports, meetups, marketplace, chat, and storage.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only keys for /admin/place-collector. Never expose these with EXPO_PUBLIC_.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-or-service-role-key
# New Supabase projects may show this as "Secret keys" with an sb_secret_ prefix.
# You can use SUPABASE_SECRET_KEY instead of SUPABASE_SERVICE_ROLE_KEY if preferred.
# SUPABASE_SECRET_KEY=sb_secret_your-secret-key
COLLECTOR_ADMIN_TOKEN=change-this-long-random-token

# Firebase Realtime Database URL for real meetup chat.
# Example: https://your-project-id-default-rtdb.asia-southeast1.firebasedatabase.app
EXPO_PUBLIC_FIREBASE_DATABASE_URL=

# Optional Firebase fallback. Supabase Auth is preferred for MANGOMAP production.
EXPO_PUBLIC_AUTH_MODE=supabase
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional future provider keys. Kakao needs a real OAuth/OIDC callback setup before enabling.
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
EXPO_PUBLIC_KAKAO_REST_API_KEY=
EXPO_PUBLIC_SMS_PROVIDER=
