  const sectionOffsets = useRef<Record<"photos" | "overview" | "comments", number>>({
    photos: 0,
    overview: 0,
    comments: 0
  });
  const [activeDetailTab, setActiveDetailTab] = useState<"photos" | "overview" | "comments">("photos");
  const [activePhotoIndex, setActivePhotoIndex] = useState(0);
  const galleryFrameWidth = Math.max(286, Math.min(viewportWidth - 36, 420));

  useEffect(() => {
    setActivePhotoIndex(0);
  }, [place.id]);

  const scrollToDetailSection = (section: "photos" | "overview" | "comments") => {
    setActiveDetailTab(section);
    const fallbackOffsets = {
      photos: 0,
      overview: galleryFrameWidth + 360,
      comments: galleryFrameWidth + 1320
    };
    const targetY = section === "photos" ? 0 : Math.max((sectionOffsets.current[section] || fallbackOffsets[section]) - 12, 0);
    const scroll = () => {
      const targetElement =
        typeof document !== "undefined" && typeof document.getElementById === "function"
          ? document.getElementById(`place-detail-${section}`)
          : null;
      targetElement?.scrollIntoView?.({ behavior: "smooth", block: "start" });
      const scrollRef = detailScrollRef.current as unknown as {
        scrollTo?: (options: { y?: number; x?: number; animated?: boolean }) => void;
        scrollResponderScrollTo?: (options: { y?: number; x?: number; animated?: boolean }) => void;
      } | null;
      scrollRef?.scrollTo?.({ y: targetY, animated: true });
      scrollRef?.scrollResponderScrollTo?.({ y: targetY, animated: true });
    };
    if (typeof requestAnimationFrame === "function") {
      requestAnimationFrame(scroll);
    } else {
      scroll();
    }
    setTimeout(scroll, 80);
