  onChangeCommentVisitType: (value: CommentVisitType) => void;
  onToggleCommentTag: (tag: string) => void;
  onBack: () => void;
  onToggleSaved: () => void;
  onOpenMap: () => void;
  onSharePlace: () => void;
  onReportPlace: () => void;
  onSubmitComment: () => void;
}) {
  const { width: viewportWidth } = useWindowDimensions();
