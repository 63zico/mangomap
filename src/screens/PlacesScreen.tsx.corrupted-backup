  const buckets = [
    { label: "\uD6CC\uB96D\uD568", score: 5, count: 0 },
    { label: "\uC88B\uC74C", score: 4, count: 0 },
    { label: "\uBCF4\uD1B5", score: 3, count: 0 },
    { label: "\uC544\uC26C\uC6C0", score: 2, count: 0 },
    { label: "\uBE44\uCD94\uCC9C", score: 1, count: 0 }
  ];

  reviewComments.forEach((comment) => {
    if (typeof comment.rating !== "number") return;
    const normalizedRating = Math.max(1, Math.min(5, Math.round(comment.rating)));
    const bucket = buckets.find((row) => row.score === normalizedRating);
    if (bucket) bucket.count += 1;
  });

  const total = buckets.reduce((sum, row) => sum + row.count, 0);
  if (total === 0) {
    return buckets.map((row) => ({
      label: row.label,
      count: 0,
      percent: 0
    }));
  }

  return buckets.map((row) => ({
    label: row.label,
    count: row.count,
    percent: row.count > 0 ? Math.max(5, Math.round((row.count / total) * 100)) : 0
  }));
}
function getAspectScores(place: CuratedPlace) {
  const base = place.rating ?? 4.6;
  return [
    { label: "\uC74C\uC2DD/\uC11C\uBE44\uC2A4", score: Math.min(5, base + 0.1) },
    { label: "\uBD84\uC704\uAE30", score: Math.min(5, base + (place.hiddenGem ? 0.2 : 0)) },
    { label: "\uC811\uADFC\uC131", score: Math.max(3.8, base - 0.2) },
    { label: "\uD55C\uAD6D\uC778 \uB9CC\uC871", score: Math.min(5, base + 0.15) }
  ];
}

function formatCommentDate(value: string) {
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return "\uCD5C\uADFC";
  const diffMs = Date.now() - date.getTime();
  const diffMinutes = Math.max(1, Math.floor(diffMs / 60000));
  if (diffMinutes < 60) return diffMinutes + "\uBD84 \uC804";
  const diffHours = Math.floor(diffMinutes / 60);
  if (diffHours < 24) return diffHours + "\uC2DC\uAC04 \uC804";
  const diffDays = Math.floor(diffHours / 24);
  if (diffDays < 30) return diffDays + "\uC77C \uC804";
  return (date.getMonth() + 1) + "\uC6D4 " + date.getDate() + "\uC77C";
}

