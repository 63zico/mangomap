            </View>
            {galleryImages.length > 1 ? (
              <Pressable
                accessibilityRole="button"
                onPress={() => scrollToPhoto((activePhotoIndex - 1 + galleryImages.length) % galleryImages.length)}
                style={styles.prevPhotoButton}
